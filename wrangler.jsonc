{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cutline-mma",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true
  }
}
